plogis(fit_part1$Yhat)
}
# 2. 第二階段：針對全部資料列計算固定效應與暴露-時間曲面 (DLM)
#    (A) 固定效應部分（考慮 dlmtree 內部的 Zscale / Zmean 標準化）
mf_train    <- model.frame(fit_part2$formula, data = df_clean[pos_idx, ])
train_terms <- delete.response(terms(mf_train))
X_all       <- model.matrix(train_terms, data = df_clean)[, -1, drop = FALSE]
#        依照 fit_part2 訓練時的 Zmean 與 Zscale 進行標準化後再乘以 gamma
X_all_scaled   <- scale(X_all, center = fit_part2$Zmean, scale = fit_part2$Zscale)
gamma_mean     <- colMeans(fit_part2$gamma)
fixed_pred_all <- as.vector(X_all_scaled %*% gamma_mean)
#    (B) 暴露-時間曲面部分（使用 sum2$matfit 與 fit_part2$Xsplits）
sum2     <- summary(fit_part2, cenval = 0)
exp_grid <- fit_part2$Xsplits   # 你版本中切分點存在 Xsplits
dlm_mat  <- sum2$matfit
dlm_pred_all <- numeric(nrow(df_clean))
for (l in seq_len(ncol(my_lag_matrix))) {
idx <- findInterval(my_lag_matrix[, l], exp_grid, all.inside = TRUE)
dlm_pred_all <- dlm_pred_all + dlm_mat[idx, l]
}
#    (C) 加上截距校正，使其在 pos_idx 上與 fit_part2$Yhat 的平均值完全一致
raw_log_pred    <- fixed_pred_all + dlm_pred_all
intercept_shift <- mean(fit_part2$Yhat) - mean(raw_log_pred[pos_idx])
log_count_pred  <- raw_log_pred + intercept_shift
# 3. 還原回原始計數尺度（含變異數校正 sigma^2 / 2）並與第一階段相乘
sigma2_mean              <- mean(fit_part2$sigma2)
expected_count_given_pos <- exp(log_count_pred + 0.5 * sigma2_mean)
combined_y_hat           <- prob_nonzero * expected_count_given_pos
# 4. 計算並印出合併後的模型準確度指標
rmse_combined <- sqrt(mean((df_clean$y - combined_y_hat)^2))
mae_combined  <- mean(abs(df_clean$y - combined_y_hat))
cor_combined  <- cor(df_clean$y, combined_y_hat)
cat(sprintf("Combined Hurdle TDLNM -> RMSE: %.3f | MAE: %.3f | Correlation (r): %.3f\n",
rmse_combined, mae_combined, cor_combined))
# 5. 畫出實際值 vs. 合併模型預測值的時間序列對照圖
plot(df_clean$y, type = "l", col = "gray60", ylab = "Count (y)", xlab = "Time Index",
main = "Observed vs. Combined Hurdle TDLNM Predictions")
lines(combined_y_hat, col = "red", lwd = 1.5)
legend("topright", legend = c("Observed", "Predicted"), col = c("gray60", "red"), lty = 1)
cor(fit_part2$Yhat, log_count_pred[pos_idx])
# 1. Part 1: Probability P(y > 0)
prob_nonzero <- if (min(fit_part1$Yhat) >= 0 && max(fit_part1$Yhat) <= 1) {
fit_part1$Yhat
} else {
plogis(fit_part1$Yhat)
}
# 2. Part 2: Reconstruct on the EXACT internal scale of dlmtree
mf_train    <- model.frame(fit_part2$formula, data = df_clean[pos_idx, ])
train_terms <- delete.response(terms(mf_train))
X_all       <- model.matrix(train_terms, data = df_clean)[, -1, drop = FALSE]
#    (A) Fixed effects: multiply by gamma_mean AND rescale by fit_part2$Yscale!
X_all_scaled   <- scale(X_all, center = fit_part2$Zmean, scale = fit_part2$Zscale)
gamma_mean     <- colMeans(fit_part2$gamma)
fixed_pred_all <- as.vector(X_all_scaled %*% gamma_mean) * fit_part2$Yscale
#    (B) DLM surface: sum2$matfit is already on the unscaled log(y) scale
sum2     <- summary(fit_part2, cenval = 0)
exp_grid <- fit_part2$Xsplits
dlm_mat  <- sum2$matfit
dlm_pred_all <- numeric(nrow(df_clean))
for (l in seq_len(ncol(my_lag_matrix))) {
idx <- findInterval(my_lag_matrix[, l], exp_grid, all.inside = TRUE)
dlm_pred_all <- dlm_pred_all + dlm_mat[idx, l]
}
#    (C) Combine and align intercept
raw_log_pred    <- fixed_pred_all + dlm_pred_all
intercept_shift <- mean(fit_part2$Yhat) - mean(raw_log_pred[pos_idx])
log_count_pred  <- raw_log_pred + intercept_shift
#    (D) Use the EXACT stored fit_part2$Yhat for all positive rows!
log_count_pred[pos_idx] <- fit_part2$Yhat
# 3. Back-transform with variance correction (note: also check if sigma2 needs Yscale^2)
#    Compare empirical residual variance on original log(y) scale to be 100% safe:
resid_var_log            <- mean((log(df_clean$y[pos_idx]) - fit_part2$Yhat)^2)
expected_count_given_pos <- exp(log_count_pred + 0.5 * resid_var_log)
combined_y_hat <- prob_nonzero * expected_count_given_pos
# 4. Re-check metrics and plot
rmse_combined <- sqrt(mean((df_clean$y - combined_y_hat)^2))
mae_combined  <- mean(abs(df_clean$y - combined_y_hat))
cor_combined  <- cor(df_clean$y, combined_y_hat)
cat(sprintf("Corrected Hurdle TDLNM -> RMSE: %.3f | MAE: %.3f | Correlation (r): %.3f\n",
rmse_combined, mae_combined, cor_combined))
# Plot full range so spikes aren't cut off at y = 1.0
plot(df_clean$y, type = "l", col = "gray60", ylab = "Count (y)", xlab = "Time Index",
main = "Observed vs. Combined Hurdle TDLNM Predictions")
lines(combined_y_hat, col = "red", lwd = 1.5)
legend("topright", legend = c("Observed", "Predicted"), col = c("gray60", "red"), lty = 1)
# 1. Check if fit_part2$Yhat is on the log(y) scale or already standardized
#    (Compare mean of fit_part2$Yhat vs mean of log(df_clean$y[pos_idx]))
cat("Mean log(y[pos_idx]):", mean(log(df_clean$y[pos_idx])), "\n")
cat("Mean fit_part2$Yhat: ", mean(fit_part2$Yhat), "\n")
# 2. If fit_part2$Yhat is standardized (mean ~ 0, sd ~ 1), unscale it back to log(y) scale!
#    Otherwise keep it as is.
if (abs(mean(fit_part2$Yhat)) < 0.05 && abs(mean(log(df_clean$y[pos_idx]))) > 0.1) {
y_hat_pos_log <- fit_part2$Yhat * fit_part2$Yscale + fit_part2$Ymean
} else {
y_hat_pos_log <- fit_part2$Yhat
}
# 3. Safely bound log_count_pred to the observed min/max of log(y) so splines can't explode in zero-gaps
obs_log_range <- range(log(df_clean$y[pos_idx]))
log_count_pred_safe <- pmin(pmax(log_count_pred, obs_log_range[1]), obs_log_range[2])
log_count_pred_safe[pos_idx] <- y_hat_pos_log
# 4. Back-transform using Duan's smearing factor (non-parametric, avoids exp(sigma^2/2) blowup)
smearing_factor <- mean(exp(log(df_clean$y[pos_idx]) - y_hat_pos_log))
expected_count_given_pos <- exp(log_count_pred_safe) * smearing_factor
# 5. Multiply by Part 1 probability P(y > 0)
combined_y_hat <- prob_nonzero * expected_count_given_pos
# 6. Print clean metrics and plot
rmse_combined <- sqrt(mean((df_clean$y - combined_y_hat)^2))
mae_combined  <- mean(abs(df_clean$y - combined_y_hat))
cor_combined  <- cor(df_clean$y, combined_y_hat)
cat(sprintf("Safe Combined Hurdle -> RMSE: %.3f | MAE: %.3f | Correlation (r): %.3f\n",
rmse_combined, mae_combined, cor_combined))
plot(df_clean$y, type = "l", col = "gray60", ylab = "Count (y)", xlab = "Time Index",
main = "Observed vs. Safe Combined Hurdle TDLNM")
lines(combined_y_hat, col = "red", lwd = 1.5)
legend("topright", legend = c("Observed", "Predicted"), col = c("gray60", "red"), lty = 1)
