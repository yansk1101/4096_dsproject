prob_nonzero <- if (min(fit_part1$Yhat) >= 0 && max(fit_part1$Yhat) <= 1) {
fit_part1$Yhat
} else {
plogis(fit_part1$Yhat)
}
# 2. 第二階段：針對全部資料列計算固定效應與暴露-時間曲面 (DLM)
#    (A) 固定效應部分（考慮 dlmtree 內部的 Zscale / Zmean 標準化）
mf_train    <- model.frame(fit_part2$formula, data = df_clean[pos_idx, ])
train_terms <- delete.response(terms(mf_train))
X_all       <- model.matrix(train_terms, data = df_clean)[, -1, drop = FALSE]
#        依照 fit_part2 訓練時的 Zmean 與 Zscale 進行標準化後再乘以 gamma
X_all_scaled   <- scale(X_all, center = fit_part2$Zmean, scale = fit_part2$Zscale)
gamma_mean     <- colMeans(fit_part2$gamma)
fixed_pred_all <- as.vector(X_all_scaled %*% gamma_mean)
